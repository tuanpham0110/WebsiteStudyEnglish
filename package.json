{
  "name": "englishai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run build && wrangler pages dev dist --port 8788",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "wrangler pages dev dist --port 8788",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --project db",
    "test:server": "vitest run --project server",
    "test:web": "vitest run --project web",
    "gen:seed": "node scripts/generate-seed.mjs",
    "test:rls:remote": "node scripts/rls-smoke.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name englishai",
    "test:e2e": "playwright test",
    "smoke:gemini": "node scripts/gemini-smoke.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
