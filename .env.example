# Frontend build-time variables (Vite). ONLY public values belong here — they are
# embedded in the static JS bundle and visible to anyone.
# Copy to .env.local for local development.

# Supabase project URL: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=
# Publishable key (sb_publishable_...) — or the legacy "anon" key. Never the secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: base URL of the API. Leave empty when the API is served from the same
# origin (Cloudflare Pages Functions under /api).
VITE_API_BASE_URL=
